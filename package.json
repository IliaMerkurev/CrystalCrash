{
  "name": "crystal-crash",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/inline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "editor": "vite --config vite.editor.config.js --open /editor.html",
    "editor:build": "vite build --mode editor --config vite.editor.config.js",
    "editor:preview": "vite preview --config vite.editor.config.js",
    "preset:import": "node scripts/import-preset.mjs",
    "editor:check": "node --test tests/editor-document.test.mjs && node tests/editor-schema.mjs && node tests/editor-runtime.mjs && node tests/editor-persistence.mjs",
    "editor:save-check": "node tests/editor-source-save.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "@dimforge/rapier3d-compat": "0.19.3"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
